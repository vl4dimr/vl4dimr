{
  "name": "entre-campus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run validar && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "validar": "tsx scripts/validar-datos.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "vapid": "tsx scripts/generar-vapid.ts",
    "lighthouse": "lhci autorun",
    "verificar": "npm run lint && npm run typecheck && npm run validar && npm test && npm run build && npm run e2e -- --trace off"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "preact": "^11.2.0",
    "workbox-broadcast-update": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261123.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/leaflet": "^1.9.22",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.167.0"
  }
}
